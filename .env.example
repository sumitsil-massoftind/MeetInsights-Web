# App
APP_BASE_URL=http://127.0.0.1:8000
DEBUG=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=meetinsights

# RabbitMQ (meeting id jobs)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_MEETING_QUEUE=meetinsights.meetings
# Uploaded / recorded videos ready for MeetInsight
RABBITMQ_RECORDING_QUEUE=meetinsights.recordings

# Local recordings folder (same folder MeetRecorder uses; not S3 yet)
# Default if unset: ../MeetRecorder/recordings
RECORDINGS_DIR=../MeetRecorder/recordings
# 2GB default
MAX_UPLOAD_BYTES=2147483648

# Google OAuth 2.0
# Create credentials at https://console.cloud.google.com/
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# JWT + AES (same names as src/helper/jwt_helper.ts)
# JWT_SECRET must be at least 32 characters for AES-256 key material.
JWT_SECRET=change-me-to-a-long-random-secret-key!!
REFRESH_TOKEN_KEY=change-me-refresh-token-signing-key!!
JWT_ALGORITHM=HS256
JWT_EXPIRES=3600s
REFRESH_TOKEN_EXPIRE=2592000s
CRYPT_ALGO=aes-256-cbc
ENCRYPTION_IV_KEY=0123456789abcdef

# Cookies (set COOKIE_SECURE=true behind HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Browser-reachable MeetInsight Socket.IO URL
MEETINSIGHT_SOCKET_URL=http://127.0.0.1:8001

# MeetRecorder worker bot-status HTTP (option 2 live free/in-use)
MEETRECORDER_STATUS_URL=http://127.0.0.1:3002
